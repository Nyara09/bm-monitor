# /etc/systemd/system/forex.service
[Unit]
Description=Forex Agent (gunicorn)
After=network.target postgresql.service

[Service]
User=forex
Group=www-data
WorkingDirectory=/opt/forex
EnvironmentFile=/etc/forex/forex.env
ExecStart=/opt/forex/venv/bin/gunicorn forex.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
