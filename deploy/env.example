# Copy to /etc/forex/forex.env (Linux) and fill in. Never commit the real file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=forex.example.com,192.168.1.10,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://forex.example.com,http://192.168.1.10
# Set to 0 only if you serve plain http on a closed local network
DJANGO_HTTPS=1

# PostgreSQL (recommended). Leave empty to keep using SQLite.
DATABASE_URL=postgres://forex:STRONG_PASSWORD@localhost:5432/forex

FOREX_BUSINESS_NAME=Forex Agent
FOREX_BASE_CURRENCY=UGX
FOREX_KYC_ID_THRESHOLD=3500000

# Backups
FOREX_BACKUP_DIR=/var/backups/forex
FOREX_BACKUP_COPY_DIR=/mnt/usb/forex-backups
FOREX_BACKUP_KEEP_DAYS=30

# SMS receipts: console | africastalking | twilio
SMS_PROVIDER=console
SMS_DEFAULT_COUNTRY_CODE=+211
SMS_SENDER_ID=
AT_USERNAME=sandbox
AT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
